<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/baby_bg">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="BABY CARE"
            android:textColor="@color/baby_pink_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="분석 기록"
            android:textColor="@color/baby_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="아기의 울음 패턴과 상태 변화를 한눈에 볼 수 있어요."
            android:textColor="@color/baby_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_baby_soft_pink"
            android:padding="12dp"
            android:text="※ 본 화면은 진료 참고용 기록이며 의료적 진단을 의미하지 않습니다."
            android:textColor="#B04A56"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="울음 패턴 요약"
            android:textColor="@color/baby_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_record_card"
            android:lineSpacingExtra="4dp"
            android:padding="18dp"
            android:text="최근 7일 울음 감지: 0회"
            android:textColor="@color/baby_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/baby_pink"
            android:text="울음 기록 새로고침"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="날짜별 기록"
            android:textColor="@color/baby_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/dateNavigationCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_record_card"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevDate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:text="←"
                    android:textColor="@color/baby_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/baby_pink_soft"
                    app:cornerRadius="18dp" />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_baby_soft_pink"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="📅  오늘"
                    android:textColor="@color/baby_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextDate"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:text="→"
                    android:textColor="@color/baby_text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/baby_pink_soft"
                    app:cornerRadius="18dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvSpecialDateIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:text="✓ 특이사항이 기록된 날짜는 체크로 표시돼요."
                android:textColor="@color/baby_muted"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="날짜를 누르면 달력에서 바로 선택할 수 있고, 좌우로 밀어 하루씩 이동할 수 있어요."
                android:textColor="@color/baby_muted"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="울음 원인"
                android:textColor="@color/baby_text"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerLabel"
                android:layout_width="match_parent"
                android:layout_height="48dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleSpecialNoteForm"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/baby_pink_dark"
            android:text="특이사항 메모 작성 ▼"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/specialNoteFormContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_record_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="수유 · 수면 · 배변"
                android:textColor="@color/baby_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="수유 형태"
                android:textColor="@color/baby_text"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rgFeedingType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbBreast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="모유" />

                <RadioButton
                    android:id="@+id/rbFormula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분유" />

                <RadioButton
                    android:id="@+id/rbMixed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="혼합" />
            </RadioGroup>

            <EditText
                android:id="@+id/etFeedsPerDay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="하루 수유 횟수"
                android:inputType="number"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etSleepHours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="하루 수면시간(시간)"
                android:inputType="numberDecimal"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etWetDiapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="하루 젖은 기저귀 횟수"
                android:inputType="number"
                android:maxLines="1" />

            <EditText
                android:id="@+id/etStoolCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="하루 대변 횟수"
                android:inputType="number"
                android:maxLines="1" />

            <CheckBox
                android:id="@+id/cbFeedingDecrease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="최근 평소보다 수유량 또는 수유 횟수가 줄었음" />

            <CheckBox
                android:id="@+id/cbHardToSoothe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="최근 평소보다 달래기 어려운 울음이 있음" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="최근 동반 증상"
                android:textColor="@color/baby_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/cbFever"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="발열" />

            <CheckBox
                android:id="@+id/cbVomiting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="구토" />

            <CheckBox
                android:id="@+id/cbDiarrhea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="설사" />

            <CheckBox
                android:id="@+id/cbBreathing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="호흡이 힘들어 보이거나 평소와 다른 호흡" />

            <CheckBox
                android:id="@+id/cbLethargy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="평소보다 처지거나 반응이 적음" />

            <CheckBox
                android:id="@+id/cbRash"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="새로 생긴 발진" />

            <CheckBox
                android:id="@+id/cbConstipationOrBlood"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="심한 변비 또는 혈변이 의심됨" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="보호자 메모"
                android:textColor="@color/baby_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCaregiverMemo"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:hint="평소와 다른 점, 울음 전후 상황, 의사에게 물어볼 내용을 적어주세요."
                android:inputType="textMultiLine"
                android:padding="12dp" />

            <Button
                android:id="@+id/btnSaveSpecialNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/baby_pink"
                android:text="특이사항 저장"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSpecialNoteStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="저장한 특이사항은 이 기기의 목록에 누적됩니다."
                android:textColor="@color/baby_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleSpecialNoteList"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#A99E9B"
            android:text="특이사항 목록 (0) ▼"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/specialNoteListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="시간대별 울음 기록"
            android:textColor="@color/baby_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="아직 저장된 진료용 기록이 없습니다."
            android:textColor="#95A5A6"
            android:textSize="16sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/recordListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="76dp"
        android:background="@android:color/white"
        app:itemIconTint="@color/bnv_item_color"
        app:itemTextColor="@color/bnv_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
