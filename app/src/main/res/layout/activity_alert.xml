<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alertRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#FF4D4D"
    android:padding="28dp">

    <TextView
        android:id="@+id/txtAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <TextView
        android:id="@+id/txtAlertCause"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="분석 결과 확인 중"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/txtAlertConfidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="36dp" />

    <Button
        android:id="@+id/btnOpenFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="결과 확인 및 피드백 남기기"
        android:textSize="18sp"
        android:textColor="#222222"
        android:backgroundTint="#FFFFFF"
        android:layout_marginBottom="14dp" />

    <Button
        android:id="@+id/btnDismissAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="알림 끄기"
        android:textSize="18sp"
        android:textColor="#222222"
        android:backgroundTint="#FFFFFF" />

</LinearLayout>